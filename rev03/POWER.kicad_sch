	)
	(text "2. From +5V0: three TPS562201 bucks (+3V3_D, +2V5, +1V0) and the +3V3_A LDO."
		(exclude_from_sim no)
		(at 38.1 337.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e74aae5f-be98-524c-b031-14bd0dcdadfc")
	)
	(text "3. TPS7A8300 LDOs: +1V8_A from +2V5, +1V8_D from +3V3_D. -3V3 from an LM2663 inverter."
		(exclude_from_sim no)
		(at 38.1 341.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2317bcd0-d0b7-5b38-8f5c-fc6ccc09ea68")
	)
	(text "4. +2V5 also powers the FPGA's LVDS banks (IAS_LINK_SPEC 3). +1V2 is a divider: bias only."
		(exclude_from_sim no)
		(at 38.1 345.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a9eedbab-fba9-5b86-8b81-01badc08d08a")
	)
	(text "5. Every value comes from the datasheet's typical application: see docs/POWER_SPEC.md."
		(exclude_from_sim no)
		(at 38.1 349.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "689311e9-a3da-52bb-a5ab-f39aa9d690ab")
	)
