	(text "C403-C408: one at each U401 VCC pin (ADCLK948 p.10). C422 at Y401 VDD."
		(exclude_from_sim no)
		(at 60.96 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fe4ffbac-ee64-51e8-9f00-9697af1d7fde")
	)
	(text "CLK_REF_IN: 0.4-3.4 Vpp (ADCLK948 Table 1), 50 ohm on chip."
		(exclude_from_sim no)
		(at 139.7 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3ec1f5f0-cf7b-50bf-8694-3adb0cc58dae")
	)
	(text "Si549: order LVPECL, 3.3 V, 5x7 mm, pinout code C. Startup frequency"
		(exclude_from_sim no)
		(at 88.9 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "faa6cf78-6d86-50bf-91dd-24fae9eff56c")
	)
	(text "is irrelevant: the FPGA sets 400 or 500 MHz over I2C."
		(exclude_from_sim no)
		(at 88.9 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f2531adb-a8b6-5c1d-827e-66439a5ce60b")
	)
	(text "CLK_SEL: FPGA open-drain. High/open = CLK1 (Si549), low = CLK0 (SMA)."
		(exclude_from_sim no)
		(at 88.9 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5ab2249c-5234-543e-9b5c-90d4913ea6fe")
	)
	(text "Q0: to the AD9484 (ADC_RADAR)"
		(exclude_from_sim no)
		(at 256.54 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a584c942-9d5e-55ec-8450-8de1c6eeefce")
	)
	(text "Q1: to the AD9253 (ADC_SDR)"
		(exclude_from_sim no)
		(at 256.54 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "440427c9-d1ce-5260-b93a-4fba4437046c")
	)
	(text "Q2: to the XC7A50T (CONTROL)"
		(exclude_from_sim no)
		(at 256.54 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ee4e66cf-d2a0-5f16-b09d-4138c1a45877")
	)
	(text "Q3: CLK_OUT SMA"
		(exclude_from_sim no)
		(at 256.54 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ca536073-82c8-55a5-8bf3-321e09d69e94")
	)
	(text "Receiver side, on the consuming sheet: 100 ohm across each pair (ADCLK948 Figure 17)."
		(exclude_from_sim no)
		(at 243.84 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1960975a-adc7-57f1-a4e5-b0af0a56001f")
	)
	(text "CLOCK - how this sheet works"
		(exclude_from_sim no)
		(at 38.1 215.9 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "cdc14652-cad1-56eb-aede-937619ff6344")
	)
	(text "1. One master clock, 400 or 500 MHz, from the Si549 (CLK1, default) or from AERIS-10 via J401 (CLK0)."
		(exclude_from_sim no)
		(at 38.1 219.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ff27a02b-724b-51bd-a57c-a4417214d0f4")
	)
	(text "2. U401 copies it to the AD9484, the AD9253 and the FPGA. The AD9253 divides it internally (1..8)."
		(exclude_from_sim no)
		(at 38.1 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f4cea5b5-050a-5ebf-aa36-d2d80790fd81")
	)
	(text "3. The DAC clocks are NOT here: both DACs take CMOS clocks, which the FPGA generates with their data."
		(exclude_from_sim no)
		(at 38.1 227.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b821f641-f681-5f2a-986d-0f0014820a91")
	)
	(text "4. Every value on this sheet is justified in _work/sheets/clock_spec.py and docs/CLOCK_SPEC.md."
		(exclude_from_sim no)
		(at 38.1 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ca9d4d7e-c412-50f6-a49c-2d9cd9a1cf1b")
	)
