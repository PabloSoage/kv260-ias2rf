	(text "Second SDR channels: straight to their SMAs, DC-blocked."
		(exclude_from_sim no)
		(at 289.56 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fe4c807e-97a0-548c-b520-ae593556ce39")
	)
	(text "ROUTING - how this sheet works"
		(exclude_from_sim no)
		(at 289.56 139.7 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "b0ddbe76-6994-5293-a4fe-47f9865bdc0d")
	)
	(text "1. Each SPDT connects a converter to its own chain (RF1, default)"
		(exclude_from_sim no)
		(at 289.56 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ad53bfed-98b6-582b-b269-4e04d21aaea5")
	)
	(text "   or to the other one (RF2), under SW_CTRL0..3 from the FPGA."
		(exclude_from_sim no)
		(at 289.56 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f4f19737-5182-5986-81fe-29696e436696")
	)
	(text "2. Supply and control networks: M3SWA2 datasheet Figure 2, per switch."
		(exclude_from_sim no)
		(at 289.56 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0bd05566-739f-5367-8d8f-e9236b53c3fc")
	)
	(text "3. Every SMA is DC-blocked: 'All RF-ports must be DC blocked or held at 0 V DC'."
		(exclude_from_sim no)
		(at 289.56 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3e24c543-c664-5cbb-a6bc-a2fd56e24475")
	)
	(text "4. The switches need VDD +3.3 V and VEE -3.3 V (B-03)."
		(exclude_from_sim no)
		(at 289.56 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ea16404d-01a5-5f42-90cd-0d62894b404e")
	)
	(text "5. Values and sources: _work/sheets/routing_spec.py, docs/ROUTING_SPEC.md."
		(exclude_from_sim no)
		(at 289.56 162.56 0)
		(effects
			(font
