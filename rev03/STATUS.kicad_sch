		(uuid "4629d2a5-cd99-5160-aacc-fb73be66bcbc")
	)
	(text "2. D1509 on PMOD_SPARE2 (the debug UART's TX): lit while the line is low, so it flickers once a second (heartbeat)."
		(exclude_from_sim no)
		(at 20.32 391.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ea77e42f-1ef8-5003-bbde-c7ab46889ea7")
	)
	(text "3. Rail LEDs: dark = dead rail. +1V8_D and +1V0 drive an NPN that switches their LED from +3V3_D."
		(exclude_from_sim no)
		(at 20.32 396.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e979f5e8-b9a9-5a0b-91f5-090a655d6818")
	)
	(text "4. J1501 USB-C -> U1503 ESD -> U1502 CH340X at 3.3 V from the cable (U1504): /dev/ttyUSBx at 115200 8N1."
		(exclude_from_sim no)
		(at 20.32 401.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7d9a1a4e-d126-5d77-b998-1bca20c69854")
	)
	(text "5. GPS PPS: J1503 -> D1530, R1540 -> U1505 -> R1542 (J1502 pin 12), R1543 (pin 4); FFC to KV260 J9, pin 12 = HDA10 (PL)."
		(exclude_from_sim no)
		(at 20.32 405.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dd134a59-2eaf-57d5-b5db-cffef5c93584")
	)
