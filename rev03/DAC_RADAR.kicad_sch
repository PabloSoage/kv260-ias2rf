	)
	(text "+3V3_A is the analogue LDO; no extra filter (AD9708 Figure 22 is for a shared supply)."
		(exclude_from_sim no)
		(at 38.1 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a17897d5-834e-59ee-910d-505838dc8d10")
	)
	(text "Reconstruction filter: AERIS-10's, as designed (107.3 nH, 32.8/106/22 pF)."
		(exclude_from_sim no)
		(at 160.02 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fadb9609-38aa-50d2-9a41-fe2d05ba0e91")
	)
	(text "DAC_RADAR - how this sheet works"
		(exclude_from_sim no)
		(at 38.1 190.5 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "d6ecdfd5-841b-5d53-b8c3-42a55b0e3b07")
	)
	(text "1. The FPGA sends 8-bit samples and their clock (3.3 V CMOS); series 22 ohm sit at the FPGA end, on CONTROL."
		(exclude_from_sim no)
		(at 38.1 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "815fb0c5-d0d2-57ee-a228-e653620b5255")
	)
	(text "2. Internal 1.2 V reference (REFLO to ACOM), RSET 1.91 kohm: 20 mA full scale. AERIS-10 differs here, see the spec."
		(exclude_from_sim no)
		(at 38.1 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8361c9ce-2475-530c-916c-0ae4fbd8fe4a")
	)
	(text "3. 50 ohm loads, then AERIS-10's differential LC reconstruction filter, then a 2:1 balun to 50 ohm single-ended."
		(exclude_from_sim no)
		(at 38.1 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f22584f0-a8ce-50d3-b6bc-cd606beeb2ba")
	)
	(text "4. Every value is justified in _work/sheets/dac_radar_spec.py and docs/DAC_RADAR_SPEC.md."
		(exclude_from_sim no)
		(at 38.1 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d8367114-ef5a-58ea-9552-bf3e8ee82d80")
	)
