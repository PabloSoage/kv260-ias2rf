	(text "C805 at AVDD pin 47; C806, C807 at DVDD1/DVDD2 pins 16/22."
		(exclude_from_sim no)
		(at 38.1 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e55f6309-d00c-5018-98c4-347de00c9440")
	)
	(text "DAC1 -> IF_TX_A, DAC2 -> IF_TX_C. Filters: AERIS-10's, as on DAC_RADAR."
		(exclude_from_sim no)
		(at 139.7 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4f3aef0f-c472-55e8-ab22-fe675d705de1")
	)
	(text "DAC_SDR - how this sheet works"
		(exclude_from_sim no)
		(at 139.7 200.66 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "31172ed0-791c-5add-9a41-06663a9569c8")
	)
	(text "1. Interleaved mode (MODE low): the FPGA writes I and Q alternately on one 14-bit port; IQSEL steers each word."
		(exclude_from_sim no)
		(at 139.7 204.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ceab925c-fda3-5598-84cf-ff374cde9542")
	)
	(text "2. IQCLK is divided by 2 inside; IQRESET aligns the pair. Series 22 ohm on the data sit at the FPGA, on CONTROL."
		(exclude_from_sim no)
		(at 139.7 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5e9c0e68-b20f-5292-8e99-671a9a867ca7")
	)
	(text "3. Internal 1.2 V reference; RSET 3.83 kohm per DAC = 10 mA, 0.5 V on 49.9 ohm: best distortion (p.24)."
		(exclude_from_sim no)
		(at 139.7 212.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1235c34c-01f4-5a1e-a5f6-1ef8592b5621")
	)
	(text "4. Every value is justified in _work/sheets/dac_sdr_spec.py and docs/DAC_SDR_SPEC.md."
		(exclude_from_sim no)
		(at 139.7 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7acb38dd-a09a-58b7-808b-cabce42bd72a")
	)
