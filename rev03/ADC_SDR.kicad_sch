	(text "C661/C662 at U602 VCC 8/13, C663/C664 at U603. C666-C672 one per AVDD pin, C674/C675 one per DRVDD pin."
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7cb56a3f-0cba-5005-8cd8-181a3f5ca655")
	)
	(text "Channel A: U602, single-ended in, 12 dB (AD8352 Fig. 26, Table 7)"
		(exclude_from_sim no)
		(at 45.72 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a39ccb8-785a-5daf-970a-ebc69d3ee6c3")
	)
	(text "Channel B: U603, the same"
		(exclude_from_sim no)
		(at 45.72 252.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6a237008-9050-5fd7-8a51-4f1ab60ef5e3")
	)
	(text "Channels C, D unused: inputs held at VCM"
		(exclude_from_sim no)
		(at 205.74 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d4c7cbbf-64b2-5cb3-882d-9a74e1540dfb")
	)
	(text "ADC_SDR - how this sheet works"
		(exclude_from_sim no)
		(at 228.6 218.44 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "9094daf0-01d1-51ec-a23e-2c5d47043ed7")
	)
	(text "1. Two SDR inputs, IF_RX_A and IF_RX_C, single-ended 50 ohm, each through an AD8352 (12 dB)."
		(exclude_from_sim no)
		(at 228.6 222.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "56e906cb-c8c8-588c-b62b-b48b5d9412e4")
	)
	(text "2. The AD9253 divides the 500 MHz master clock by 8: 62.5 MSPS, one-lane mode (register 0x21, SPI)."
		(exclude_from_sim no)
		(at 228.6 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "15683ba8-7347-581e-9e75-1d48869ba106")
	)
	(text "3. One-lane: channel A leaves on D0+-B, channel B on D1+-B (AD9253 Table 8, footnote 1)."
		(exclude_from_sim no)
		(at 228.6 229.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6248aada-88f0-5676-8837-176f099c5b66")
	)
	(text "4. The inputs are not biased inside the AD9253: centre taps go to its VCM pin through 200 ohm (Fig. 58)."
		(exclude_from_sim no)
		(at 228.6 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "18f94611-1884-5390-aa5e-481cf497a5b7")
	)
	(text "5. CONV_SPI_* are 1.8 V signals (abs. max 2.0 V). LVDS terminated at the FPGA, 100 ohm per pair."
		(exclude_from_sim no)
		(at 228.6 237.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5896bbb0-590e-5b1b-90a1-c47fdf7ef8d5")
	)
