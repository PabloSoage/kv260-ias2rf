		(uuid "32a2d7a2-d7fa-5dcd-9fd9-d4f931cef29d")
	)
	(text "1. Five LVDS pairs to the Kria's HPA bank at 1.2 V: every pair AC-coupled (INTERFACE_SPEC 6.1)."
		(exclude_from_sim no)
		(at 152.4 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4bb9ca6e-1784-56a2-ab89-016924bf0beb")
	)
	(text "2. Kria -> FPGA pairs: 2 x 49.9 ohm to +1V2 terminate and re-bias them for the FPGA."
		(exclude_from_sim no)
		(at 152.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ac8b689a-0b9c-50a7-ad1c-ae5a7269686f")
	)
	(text "3. FPGA -> Kria pairs: terminated and biased inside the SOM (DIFF_TERM_ADV, DQS_BIAS)."
		(exclude_from_sim no)
		(at 152.4 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "74ff8065-d479-5048-94ef-1fd869ffe7a9")
	)
	(text "4. Pins 26/27 and 29/30 are N before P on the connector and on the carrier alike (3.2)."
		(exclude_from_sim no)
		(at 152.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8d9f7a8d-a37a-5a66-aa4d-474624b6532a")
	)
	(text "5. HK_SCL/SDA, FPGA_PROG_B, FPGA_IRQ are the carrier's 1.8 V levels: CONTROL translates."
		(exclude_from_sim no)
		(at 152.4 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "92f4b6c3-3b34-5d01-99dc-5ea5c1c87848")
	)
