# Editor local history (VS Code's Local History extension).
# It was committed as gitlinks without .gitmodules: a broken submodule that
# stops the repo from cloning cleanly.
.history/

# KiCad autosaves. 28 MB of zips that add nothing: the snapshots
# that matter are in _backup_original/.
*-backups/

# KiCad's per-user local state (window positions, zoom, visible
# layers). Not project content.
*.kicad_prl

# Simulation outputs and temporary work
*.net
fp-info-cache
~*
*.bak
*.stackdump
__pycache__/
*.pyc
_work/datasheets/

# Fabrication outputs: regenerated by _work/fab/make_fab.py
/fab/

# Local mise settings (this machine's paths, e.g. KICAD_CLI)
mise.local.toml

# The private working repository (kv260-ias2rf-docs), checked out inside this one
/docs-repo/

# Vivado / XSim scratch written to the working directory
.Xil/
.gen/
.srcs/
clockInfo.txt
*.jou
*.log.bak
