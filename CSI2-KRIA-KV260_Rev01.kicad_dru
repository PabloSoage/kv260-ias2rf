(version 1)
# RF50 lines are 183 um with 0.2 mm clearance. Where one leaves a 0.5 mm pitch pin it is necked
# down to 0.15 mm for the first millimetre or so, and that neck keeps the default clearance.
(rule "RF50 neck-down at fine-pitch pins"
	(condition "A.NetClass == 'RF50' && A.Type == 'Track' && A.Width < 0.18mm && A.Width >= 0.12mm")
	(constraint clearance (min 0.1mm)))

# Beside each SMA's ESD diode the line is 0.1 mm for 0.76 mm before and 1.4 mm after its pad: two
# high-impedance sections that tune out the diode's 0.4-0.5 pF (docs/SIGNAL_INTEGRITY.md 7.1). The
# ground pour keeps 0.24 mm off them, i.e. where it is beside the 183 um line, as simulated.
(rule "RF50 ESD compensation sections"
	(condition "A.NetClass == 'RF50' && A.Type == 'Track' && A.Width < 0.12mm")
	(constraint clearance (min 0.24mm)))

# LVDS pairs are routed coupled since the 8-layer board: 0.10 mm legs 0.15 mm apart (100 ohm on
# L3/L6), necked to 0.09 / 0.12 mm under the FPGA (98.5 ohm), which passes between two vias at 1 mm
# pitch. The two legs of a pair keep that gap; inside the FPGA's courtyard the pair keeps 0.1 mm to
# everything else, as the BGA's own fan-out does. Both orders (A, B) are written out: KiCad takes
# the larger of the two, so a rule on A alone leaves the other item's netclass in charge.
(rule "LVDS coupled legs"
	(condition "A.NetClass == 'LVDS100' && A.isCoupledDiffPair() && B.NetClass == 'LVDS100' && B.isCoupledDiffPair()")
	(constraint clearance (min 0.1mm)))
(rule "LVDS escape under the FPGA"
	(condition "(A.NetClass == 'LVDS100' && A.intersectsCourtyard('U1101')) || (B.NetClass == 'LVDS100' && B.intersectsCourtyard('U1101'))")
	(constraint clearance (min 0.1mm)))
